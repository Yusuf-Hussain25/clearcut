# Clerk -> dashboard.clerk.com -> your app -> Configure -> API keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY='pk_test_...'

# Where the Clearcut API runs (no trailing slash)
VITE_API_URL='http://localhost:4000'

# Optional: shows "Explore with a demo account" on the sign-in page.
# Use the same address as DEMO_EMAIL in server/.env (the server issues the sign-in ticket).
VITE_DEMO_EMAIL='demo@clearcut-demo.dev'
