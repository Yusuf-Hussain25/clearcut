# ---------- Required ----------

# Postgres connection string. Neon: console.neon.tech -> your project -> Connect -> copy the
# connection string (pooled is fine). Locally any Postgres works, e.g.
# postgresql://postgres:postgres@127.0.0.1:5432/clearcut. Then run: npm run migrate
DATABASE_URL='postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/clearcut?sslmode=require'

# Clerk -> dashboard.clerk.com -> your app -> Configure -> API keys
CLERK_PUBLISHABLE_KEY='pk_test_...'
CLERK_SECRET_KEY='sk_test_...'

# Browser origins allowed to call the API (comma-separated)
ORIGINS='http://localhost:5173'

# ---------- Background removal engine ----------

# local (default): free open-source model running in this server, no key, no limits
# clipdrop:        ClipDrop API, needs CLIPDROP_API_KEY (clipdrop.co/apis -> API key)
# removebg:        remove.bg API, needs REMOVE_BG_API_KEY (remove.bg/dashboard#api-key, 50 free previews a month)
BG_PROVIDER='local'
CLIPDROP_API_KEY=''
REMOVE_BG_API_KEY=''
# Local model size: medium (best) or small (faster, less memory)
# LOCAL_MODEL='medium'

# Optional limits
# FREE_CREDITS=5          # credits every new account starts with
# MAX_UPLOAD_MB=12
# MAX_IMAGE_SIDE=2048     # longest side, larger photos are scaled down first

# ---------- Payments (optional) ----------
# Without keys, plans are shown but checkout is marked unavailable.

# USD or INR (prices for both are in lib/plans.js). Razorpay accounts usually need INR.
CURRENCY='USD'
# Where Stripe returns people after checkout (defaults to the first ORIGINS entry)
# APP_URL='http://localhost:5173'

# Stripe -> Developers -> API keys (Test mode) -> Secret key
STRIPE_SECRET_KEY=''

# Razorpay -> Account & Settings -> API keys (Test mode) -> Generate key
RAZORPAY_KEY_ID=''
RAZORPAY_KEY_SECRET=''

# ---------- Clerk webhook (optional) ----------
# Clerk -> Configure -> Webhooks -> Add endpoint <api-url>/api/webhooks/clerk
# (events: user.created, user.updated, user.deleted) -> copy the Signing Secret.
# Without it, accounts are still created on their first request.
CLERK_WEBHOOK_SIGNING_SECRET=''

# ---------- Demo data (npm run seed) ----------
# Setting DEMO_EMAIL enables POST /api/demo/session, used by "Explore with a demo account"
# (set VITE_DEMO_EMAIL in client/.env to show the button). DEMO_PASSWORD lets you log in by hand.
DEMO_EMAIL='demo@clearcut-demo.dev'
DEMO_PASSWORD='choose-a-strong-password'
# Password for the other seeded accounts (@clearcut-demo.dev)
SEED_PASSWORD='choose-another-strong-password'
